# ==============================================================================
# HIFZHLY ENVIRONMENT CONFIGURATION (TEMPLATE)
# Salin file ini menjadi .env lalu sesuaikan nilainya untuk environment Anda.
# ==============================================================================
APP_ENV=development
APP_PORT=8080
FRONTEND_PORT=3000

# Security / JWT Secret (Gunakan secret unik & kuat untuk produksi)
JWT_SECRET=change_this_to_a_random_secure_jwt_secret_key

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=hifzhly_db

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
